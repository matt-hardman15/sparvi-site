```{=html}
<div class="list grid quarto-listing-cols-3 article-cards">
<% for (const item of items) { %>
<div class="g-col-1" <%= metadataAttrs(item) %>>
<a href="<%- item.path %>" class="quarto-grid-link no-external-icon">
<div class="quarto-grid-item card h-100 card-left">
<% if (item.image) { %>
<p class="card-img-top"><img loading="lazy" src="<%- item.image %>" alt="" class="thumbnail-image card-img" style="height: 150px;"></p>
<% } %>
<div class="card-body post-contents">
<div class="card-kicker"><span class="card-sport"><%= (item.categories || [])[0] || "" %></span><span class="card-date"><%= item.date %></span></div>
<h5 class="no-anchor card-title listing-title"><%= item.title %></h5>
<% if (item['card-key']) { %>
<div class="card-stat"><span class="card-stat-v" data-key="<%- item['card-key'] %>"><%= item['card-prefix'] || "" %>…<%= item['card-suffix'] || "" %></span><span class="card-stat-l"><%= item['card-label'] %></span></div>
<% } %>
<div class="card-text listing-description"><%= item.description %></div>
</div>
</div>
</a>
</div>
<% } %>
</div>
```
